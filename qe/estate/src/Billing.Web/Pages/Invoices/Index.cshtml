@page
@model Kestrel.Billing.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Invoices";
}
<h1>Invoices and credit notes</h1>
<form method="get" class="filter">
    <label for="q">Search</label>
    <input id="q" name="q" value="@Model.Q" placeholder="Number, customer or project" />
    <label for="kind">Type</label>
    <select id="kind" name="kind">
        <option value="">All</option>
        <option value="Invoice" selected="@(Model.Kind == InvoiceKind.Invoice)">Invoices</option>
        <option value="CreditNote" selected="@(Model.Kind == InvoiceKind.CreditNote)">Credit notes</option>
    </select>
    <button type="submit">Search</button>
    <a href="/Invoices/Export?q=@Model.Q">Export</a>
</form>
<table class="grid" id="invoices">
    <thead>
    <tr><th>Number</th><th>Customer</th><th>Project</th><th>Invoice date</th><th>Due date</th><th class="num">Total</th></tr>
    </thead>
    <tbody>
    @foreach (var i in Model.Invoices.Take(200))
    {
        <tr>
            <td><a href="/Invoices/Details/@i.Id">@i.Number</a></td>
            <td>@i.Customer.Name</td>
            <td>@i.Project.Code</td>
            <td>@i.InvoiceDate.ToString("yyyy-MM-dd")</td>
            <td>@i.DueDate?.ToString("yyyy-MM-dd")</td>
            <td class="num">@BillingHelper.FormatMoney(i.Total, i.Currency)</td>
        </tr>
    }
    </tbody>
</table>
<p class="muted">@Model.Invoices.Count documents@(Model.Invoices.Count > 200 ? ", showing the latest 200" : "").</p>
