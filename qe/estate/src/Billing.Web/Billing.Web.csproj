<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kestrel.Billing</RootNamespace>
    <AssemblyName>Billing.Web</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Legacy code: warnings were never cleaned up and are not treated as errors. -->
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8604;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
