# Copy to .env to override. Every value has a working local default.
STUDIO_DATABASE_URL=postgresql+psycopg://studio:studio@db:5432/studio
STUDIO_LLM_MODE=replay
STUDIO_STORAGE_ROOT=/workspace/storage
# Set by the Azure deployment. Leave empty to store files in the folder above.
STUDIO_BLOB_ACCOUNT_URL=
# Only needed for STUDIO_LLM_MODE=live
ANTHROPIC_API_KEY=
